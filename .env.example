# PoB Pipeline Environment Variables
# Copy this file to .env and fill in your values

# GitHub Gist Sync (for cross-device dashboard)
# 1. Create secret Gist: https://gist.github.com/ (one empty file: character_state.json)
# 2. Create fine-grained PAT: GitHub Settings → Developer settings → Personal access tokens → Fine-grained
#    Permissions: Gist → Read & Write only
GH_GIST_ID=your-gist-id-here
GH_TOKEN=ghp_xxx-your-token-here

# Optional: PoB repo path (if not default ~/pob_repo)
# POB_REPO_PATH=C:\Users\YourName\pob_repo